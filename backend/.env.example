# ── Required ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Supabase Postgres — use the pooler (port 6543) for the app, direct (5432) for migrations
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Optional but recommended ─────────────────────────────
# CORS — set to your frontend domain or * to allow all
CORS_ORIGIN=*

# Redis — only needed for multi-instance Socket.IO (Railway Redis add-on)
# REDIS_URL=redis://...

# ── Supabase Storage (photo uploads) ─────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── SMS (optional) ────────────────────────────────────────
SMSPORTAL_AUTH_MODE=basic
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
SMS_PROVIDER=smsportal
