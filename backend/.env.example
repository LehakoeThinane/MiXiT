# ── Required ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Supabase Postgres — use the pooler (port 6543) for the app, direct (5432) for migrations
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Optional but recommended ─────────────────────────────
# CORS — set to your frontend domain or * to allow all
CORS_ORIGIN=*

# Redis — only needed for multi-instance Socket.IO (Railway Redis add-on)
# REDIS_URL=redis://...

# ── Supabase Storage (photo uploads) ─────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (PayFast) ────────────────────────────────────
# PUBLIC_API_URL must be this API's real public HTTPS URL (e.g. your Render
# service URL) — PayFast calls PAYFAST notify_url server-to-server, and the
# checkout bridge page's return/cancel URLs are built from it too.
PUBLIC_API_URL=https://mixit-api.onrender.com
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# ── Auth (Google Sign-In) ─────────────────────────────────
# Comma-separated — accept ID tokens minted for any of the iOS/Android/Web
# OAuth client IDs from the same Google Cloud project. Leave empty to disable
# (POST /auth/google returns 501 until at least one is set).
GOOGLE_CLIENT_IDS=

# ── Observability ─────────────────────────────────────────
# Leave empty to disable — Sentry stays fully off until this is set.
SENTRY_DSN=

# ── Auth (Sign in with Apple) ─────────────────────────────
# Accepted `aud` values for Apple identity tokens — the iOS bundle identifier.
APPLE_CLIENT_IDS=com.mixit.app
# Optional but required by Apple for account deletion: a "Sign in with Apple" key
# from Apple Developer > Certificates, IDs & Profiles > Keys. Lets the API revoke
# the user's Apple authorization when they delete their account. Paste the .p8
# contents with literal \n for newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── In-app purchases (RevenueCat) ─────────────────────────
# Set the same value as the webhook "Authorization header" in RevenueCat
# (Project > Integrations > Webhooks), pointing at
# https://<your-api>/payments/revenuecat/webhook
REVENUECAT_WEBHOOK_AUTH=

# ── Legal pages (/legal/privacy, /legal/terms, …) ─────────
LEGAL_ENTITY_NAME=Peloentle Digital Solution
SUPPORT_EMAIL=mixit@peloentle.com

# ── Moderation ────────────────────────────────────────────
# Enables the moderator API at /admin/* (send as header x-admin-key).
# At least 32 chars: openssl rand -hex 32. Empty = admin API disabled.
ADMIN_API_KEY=
# Optional Slack/Discord incoming-webhook URL — pinged for every new report
# (underage reports are flagged URGENT). Apple expects reports actioned in 24h.
MODERATION_WEBHOOK_URL=

# ── App review demo account ───────────────────────────────
# Credentials you give Apple (App Review Information) and Google (App access) so
# reviewers can sign in without a personal Google/Apple account. Password ≥ 16
# chars. Leave both empty to disable the reviewer sign-in endpoint.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_PASSWORD=
