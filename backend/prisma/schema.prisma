generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String           @id @default(uuid())
  phone          String?          @unique
  email          String           @unique
  googleId       String?          @unique @map("google_id")
  appleId        String?          @unique @map("apple_id")
  termsAcceptedAt DateTime?       @map("terms_accepted_at")
  // Moderation: bannedAt = suspended (cannot sign in, content removed); heldAt =
  // hidden from Discover/rooms pending review (e.g. reported as underage).
  bannedAt       DateTime?        @map("banned_at")
  heldAt         DateTime?        @map("held_at")
  // Hosts (set by admins) can schedule room sessions and meetups.
  isHost         Boolean          @default(false) @map("is_host")
  // Referrals: each user's shareable invite code, who invited them, and when the
  // "both get a Vibe Boost" reward was granted (once per referred user).
  referralCode       String?      @unique @map("referral_code")
  referredById       String?      @map("referred_by_id")
  referralRewardedAt DateTime?    @map("referral_rewarded_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  profile        Profile?
  sent           Message[]        @relation("sent_messages")
  received       Message[]        @relation("received_messages")
  sentVibes      Vibe[]           @relation("vibe_sender")
  receivedVibes  Vibe[]           @relation("vibe_recipient")
  roomMembership RoomMembership[]
  roomMessages   RoomMessage[]
  purchases      UserPurchase[]
  refreshSessions RefreshSession[]
  blocksMade      Block[]  @relation("blocks_made")
  blocksReceived  Block[]  @relation("blocks_received")
  reportsMade     Report[] @relation("reports_made")
  reportsReceived Report[] @relation("reports_received")
  hostedEvents    RoomEvent[]
  eventRsvps      RoomEventRsvp[]

  @@index([referredById])
  @@map("users")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("blocks_made", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocks_received", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  reportedId String   @map("reported_id")
  reason     String
  details    String?
  // Server-captured snapshot of the reported message (never client-supplied text).
  evidence   String?
  reviewedAt DateTime? @map("reviewed_at")
  resolution String?
  status     String   @default("open") // open | reviewed | dismissed
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation("reports_made", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("reports_received", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@index([status, createdAt])
  @@map("reports")
}

model RefreshSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  String?   @unique @map("replaced_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy  RefreshSession? @relation("refresh_session_replacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedFor RefreshSession? @relation("refresh_session_replacement")

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_sessions")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  age         Int
  gender      String
  bio         String?
  city        String?
  locationLat Float?   @map("location_lat")
  locationLng Float?   @map("location_lng")
  interests   Json?
  intents     Json?
  traits      Json?
  photos      Json?
  showPhone   Boolean  @default(true) @map("show_phone")
  showLastSeen Boolean @default(true) @map("show_last_seen")
  voiceIntroUrl String? @map("voice_intro_url")
  voiceIntroDurationSec Int? @map("voice_intro_duration_sec")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastActive  DateTime? @map("last_active")
  pushToken   String?  @map("push_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([completedAt, updatedAt(sort: Desc)])
  @@index([city, completedAt, updatedAt(sort: Desc)])
  @@index([lastActive(sort: Desc)])
  @@map("profiles")
}

model Message {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  content     String?
  type        String    @default("text")
  mediaUrl    String?   @map("media_url")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User @relation("sent_messages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("received_messages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt], map: "messages_recipient_read_at_idx") // unread lookups
  @@map("messages")
}

model Vibe {
  id         String    @id @default(uuid())
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  matchedAt  DateTime? @map("matched_at")

  fromUser User @relation("vibe_sender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("vibe_recipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, matchedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([fromUserId, matchedAt])
  @@map("vibes")
}

model Room {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  city        String?
  emoji       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  memberships RoomMembership[]
  messages    RoomMessage[]
  events      RoomEvent[]

  @@map("rooms")
}

// Scheduled things happening in a room: a live chat "session" in the app, or a
// real-world "meetup" at a venue. Created by hosts only.
model RoomEvent {
  id          String    @id @default(uuid())
  roomId      String    @map("room_id")
  hostId      String    @map("host_id")
  kind        String    @default("session") // session | meetup
  title       String
  description String?
  venue       String?
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  cancelledAt DateTime? @map("cancelled_at")
  remindedAt  DateTime? @map("reminded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  room  Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host  User            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  rsvps RoomEventRsvp[]

  @@index([roomId, startsAt])
  @@index([startsAt])
  @@map("room_events")
}

model RoomEventRsvp {
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  event RoomEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("room_event_rsvps")
}

model RoomMessage {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
  @@map("room_messages")
}

model RoomMembership {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("room_memberships")
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  priceInCents Int     @map("price_in_cents")
  currency    String   @default("ZAR")
  type        String   @default("subscription") // subscription | boost | feature
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchases UserPurchase[]

  @@map("products")
}

model UserPurchase {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  productId         String    @map("product_id")
  status            String    @default("pending") // pending | active | failed | expired | cancelled
  merchantReference String    @unique @map("merchant_reference")
  gatewayPaymentId  String?   @unique @map("gateway_payment_id")
  amountInCents     Int       @map("amount_in_cents")
  currency          String    @default("ZAR")
  expiresAt         DateTime? @map("expires_at")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_purchases")
}
